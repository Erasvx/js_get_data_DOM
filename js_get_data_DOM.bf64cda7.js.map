'use strict';
var total = document.querySelector('.total-population');
var average = document.querySelector('.average-population');
var populations = document.querySelectorAll('.population');
var sum = 0;
populations.forEach(function(element) {
    var text = element.textContent.replace(/,/g, '');
    var number = parseFloat(text);
    if (!isNaN(number)) sum += number;
    else throw new Error('Error with population validation!');
});
total.textContent = sum.toLocaleString('en-US');
if (populations.length > 0) average.textContent = (sum / populations.length).toLocaleString('en-US');
else throw new Error('List of countries is empty!');

